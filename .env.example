DATABASE_URL=postgres://root:root@localhost:5433/incident_analyzer?sslmode=disable
DEDUP_WINDOW_MINUTES=10

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# false: one combined model call. true: classify, then prioritize (two calls).
TASK_DECOMPOSITION=false
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=0.5
